ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
SYMBOL=BTC/USD
TZ_NAME=America/Los_Angeles
# minutes before each 15-min close to also run (0 = at the close itself)
ALERT_LEAD_MINUTES=0,5
LOOKBACK_MINUTES=10080
# optional Discord/Slack webhook; NOTIFY_ON = BUY or BUY,WAIT,AVOID
WEBHOOK_URL=
NOTIFY_ON=BUY
# both = notify only when Claude AND the quant engine agree; either = any one
NOTIFY_MODE=both
# quant tuning (calibrate with GET \/api\/backtest)
K_DRIFT=0.15
BUY_THRESHOLD=0.2
# Claude is OPTIONAL. Leave ANTHROPIC_API_KEY blank (or USE_CLAUDE=0) to run the quant engine alone.
USE_CLAUDE=auto
# contract engine tick (seconds) and "asleep" threshold (ATR / 50-bar avg ATR)
TICK_SECONDS=5
ASLEEP_RATIO=0.75
